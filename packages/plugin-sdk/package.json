{
  "name": "@repohelix/plugin-sdk",
  "version": "2.0.0",
  "description": "Public TypeScript contracts and utilities for authoring RepoHelix plugins.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "author": "RepoHelix contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arnofeng/repohelix.git",
    "directory": "packages/plugin-sdk"
  },
  "bugs": {
    "url": "https://github.com/arnofeng/repohelix/issues"
  },
  "homepage": "https://github.com/arnofeng/repohelix/tree/main/packages/plugin-sdk#readme",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
