{
  "name": "@logiclens/plugin-runtime",
  "version": "1.0.0",
  "description": "Discovery, loading, and compatibility validation runtime for LogicLens plugins.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@logiclens/plugin-sdk": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "author": "LogicLens contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arnofeng/logiclens.git",
    "directory": "packages/plugin-runtime"
  },
  "bugs": {
    "url": "https://github.com/arnofeng/logiclens/issues"
  },
  "homepage": "https://github.com/arnofeng/logiclens/tree/main/packages/plugin-runtime#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
