{
  "name": "@repohelix/plugin-csharp",
  "version": "1.0.0",
  "description": "External C# language plugin for RepoHelix.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "test": "vitest run --pool forks --maxWorkers=1",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@repohelix/plugin-sdk": "workspace:*",
    "tree-sitter": "^0.21.1",
    "tree-sitter-c-sharp": "0.23.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "vitest": "^4.1.9"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "plugin.json",
    "README.md"
  ],
  "author": "RepoHelix contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arnofeng/repohelix.git",
    "directory": "packages/plugin-csharp"
  },
  "bugs": {
    "url": "https://github.com/arnofeng/repohelix/issues"
  },
  "homepage": "https://github.com/arnofeng/repohelix/tree/main/packages/plugin-csharp#readme",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
