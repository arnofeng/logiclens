{
  "name": "repohelix",
  "version": "1.0.0",
  "description": "Local-first semantic contract graph for AI coding agents to reason about cross-repository interfaces and change impact.",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "repohelix": "./bin/repohelix.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "README-ZH.md"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run build:packages && tsc -p tsconfig.build.json",
    "build:packages": "pnpm --filter @repohelix/plugin-sdk build && pnpm --filter @repohelix/plugin-csharp build",
    "build:prod": "pnpm run clean && pnpm run build:packages && tsc -p tsconfig.prod.json",
    "clean": "tsx scripts/clean.ts",
    "dev": "tsx src/cli.ts",
    "prepack": "pnpm run build:prod",
    "pretest": "pnpm run build:packages",
    "test": "tsx scripts/test.ts",
    "test:contract-schema-release": "tsx scripts/test.ts --suite contract-schema-release",
    "test:neo4j-integration": "tsx scripts/test.ts --suite neo4j-integration",
    "typecheck": "tsc --noEmit && tsc -p packages/plugin-sdk/tsconfig.json --noEmit && pnpm --filter @repohelix/plugin-sdk build && pnpm --filter @repohelix/plugin-csharp typecheck",
    "audit:prod": "pnpm audit --prod --audit-level=high --registry=https://registry.npmjs.org",
    "release:check": "tsx scripts/release-check.ts && tsx scripts/legacy-schema-scan.ts --artifacts",
    "benchmark:java-schema": "tsx benchmarks/java-schema/runner.ts",
    "benchmark:java-schema:smoke": "tsx benchmarks/java-schema/runner.ts --fixture tests/fixtures/contract-schema-release/repos/release-java --smoke",
    "scan:legacy-schema": "tsx scripts/legacy-schema-scan.ts",
    "scan:legacy-schema:artifacts": "tsx scripts/legacy-schema-scan.ts --artifacts",
    "release:smoke:registry": "node scripts/registry-smoke.mjs"
  },
  "keywords": [
    "codegraph",
    "kuzu",
    "tree-sitter"
  ],
  "author": "RepoHelix contributors",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arnofeng/repohelix.git"
  },
  "bugs": {
    "url": "https://github.com/arnofeng/repohelix/issues"
  },
  "homepage": "https://github.com/arnofeng/repohelix#readme",
  "dependencies": {
    "@repohelix/plugin-sdk": "workspace:*",
    "@clack/prompts": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vue/compiler-sfc": "^3.5.38",
    "commander": "^14.0.2",
    "fast-glob": "^3.3.3",
    "graphql": "^16.14.0",
    "ignore": "^7.0.5",
    "jsonc-parser": "^3.3.1",
    "kuzu": "^0.11.3",
    "neo4j-driver": "^6.1.0",
    "openai": "^6.44.0",
    "pino": "^10.3.1",
    "protocol-buffers-schema": "^3.6.1",
    "tar": "^7.5.16",
    "tree-sitter": "^0.21.1",
    "tree-sitter-go": "^0.23.4",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.21.4",
    "tree-sitter-python": "0.23.4",
    "tree-sitter-typescript": "^0.23.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/protocol-buffers-schema": "^3.4.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "fast-uri": "3.1.4",
    "postcss": "8.5.18",
    "tar": "^7.5.16"
  }
}
